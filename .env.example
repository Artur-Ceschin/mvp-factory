# Orchestrator environment. Copy to .env for local runs (`pnpm factory` loads it).
# In GitHub Actions set these as repository secrets instead. Leave unused ones empty.
# Must list exactly the keys in orchestrator/src/env.ts (enforced by env.test.ts).

# Builder agent: one of these is required for build/iterate/run.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# AWS. Region falls back to aws.region in factory.config.yaml. Credentials are optional
# (an AWS profile works locally; CI uses OIDC).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe: FOO_<STAGE> wins over FOO. *_DEV must be sk_test_; *_PROD may be sk_live_.
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_DEV=
STRIPE_SECRET_KEY_PROD=

# Pluggy (only for ideas with the pluggy integration).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_ID_DEV=
PLUGGY_CLIENT_ID_PROD=
PLUGGY_CLIENT_SECRET=
PLUGGY_CLIENT_SECRET_DEV=
PLUGGY_CLIENT_SECRET_PROD=

# Set automatically by GitHub Actions.
GITHUB_SHA=
GITHUB_STEP_SUMMARY=

# Optional: run against another checkout of the repository.
FACTORY_ROOT=
